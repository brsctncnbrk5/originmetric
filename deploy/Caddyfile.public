# Cloudflare IP snapshot checked 2026-10-02. Re-verify official lists before go-live.
{
	auto_https disable_redirects
	log {
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>uri delete
			}
		}
	}
	servers {
		timeouts {
			read_header 5s
			read_body 10s
			idle 60s
		}
	}
}
{$OM_DOMAIN} {
	tls /certs/origin.crt /certs/origin.key
	@notCloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	respond @notCloudflare 403
	@private path /internal/* /api/internal/*
	respond @private 404
	@unsafeFixture path /fixtures/basic /fixtures/gpc /fixtures/csp /fixtures/storage /fixtures/blocked /fixtures/withdrawal
	respond @unsafeFixture 404
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	reverse_proxy app:3000 {
		# Overrides any attacker-supplied token. CF IP is used only behind this CF peer gate.
		header_up X-OM-Proxy-Token {$INGEST_PROXY_TOKEN}
		transport http {
			dial_timeout 5s
			response_header_timeout 15s
		}
	}
}
