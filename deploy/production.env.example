# Real secrets are generated in .env.production (600), never committed.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
APP_DB_PASSWORD=REPLACE_WITH_SEPARATE_RANDOM_HEX
DATABASE_URL=postgres://originmetric:REPLACE_WITH_SEPARATE_RANDOM_HEX@db:5432/originmetric
INTERNAL_TOKEN=REPLACE_WITH_RANDOM_HEX
INGEST_PROXY_TOKEN=REPLACE_WITH_RANDOM_HEX
INGEST_PROXY_MODE=cloudflare
LOG_LEVEL=info
OM_HTTP_PORT=8088
# Chosen only during VPS handoff. No cloud account is assumed or created.
OM_DOMAIN=
OM_INGRESS=local
PUBLIC_G1_READY=no
AGE_RECIPIENT=
BACKUP_REMOTE=
HEALTHCHECKS_URL=
SELFCHECK_URL=
