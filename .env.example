# Copy to .env and replace the placeholders. Never commit .env.
# Local development only. These values are NOT production credentials.

# Used by docker-compose.dev.yml (PostgreSQL 18 dev container)
POSTGRES_USER=originmetric
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=originmetric_dev
POSTGRES_PORT=5432

# Used by the app, Drizzle and the DB tests.
# Must match the values above. DB tests create and drop temporary databases on this server.
DATABASE_URL=postgres://originmetric:change-me-local-dev-only@127.0.0.1:5432/originmetric_dev

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Local-only token for the P1b internal attribution proof page. Leave unset to disable it.
INTERNAL_TOKEN=change-me-local-internal-only

# P3: configure locally before deploying auth; never reuse INTERNAL_TOKEN.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Transactional email provider is not configured. No simulated delivery.
